# Copy to .env (never commit .env). All values are optional for local development.

# --- Microsoft Foundry (agents use a live model when both are set) ---------------------
# Project endpoint from the Foundry portal, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name in that project, e.g. gpt-4.1-mini
FOUNDRY_MODEL=
# auto = Foundry when configured, otherwise the deterministic policy planner; or force "foundry" / "policy"
AGENT_MODE=auto
FOUNDRY_TIMEOUT_S=25
# Authentication uses DefaultAzureCredential: `az login` locally, managed identity on Azure.

# --- Simulation ------------------------------------------------------------------------
DEFAULT_ROLLOUTS=200
MAX_ROLLOUTS=500
SIMULATION_HORIZON_S=10
SIMULATION_TIME_BUDGET_S=20

# --- Football Multiverse ---------------------------------------------------------------
MULTIVERSE_CELL_ROLLOUTS=80
MULTIVERSE_MAX_ROUNDS=3
MULTIVERSE_MAX_DEPTH=3
MULTIVERSE_MAX_NODES=40

# --- Web -------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend: URL of the API (build-time for the static export)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Telemetry (optional) ----------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
